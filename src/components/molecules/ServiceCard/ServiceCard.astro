---
// src/components/molecules/ServiceCard/ServiceCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  servicio: CollectionEntry<'servicios'>['data'];
  index: number;
}
const { servicio, index } = Astro.props;
const formattedIndex = (index + 1).toString().padStart(2, '0');
---

<article class="m-service-card" data-reveal>
  <span class="m-service-card__index">{formattedIndex}</span>
  <h3 class="m-service-card__title">{servicio.titulo}</h3>
  <p class="m-service-card__description">{servicio.descripcion}</p>
  {servicio.pendiente && servicio.pendiente.length > 0 && (
    <ul class="m-service-card__pending" role="list">
      {servicio.pendiente.map((nota) => <li>⚠ {nota}</li>)}
    </ul>
  )}
</article>

<style>
  .m-service-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--c-bg-raised);
    border: var(--border-thin);
  }
  .m-service-card__index {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--fw-bold);
    color: var(--c-accent);
    margin-bottom: var(--space-2);
  }
  .m-service-card__title {
    font-size: var(--text-h3);
    font-weight: var(--fw-semibold);
    margin-bottom: var(--space-3);
  }
  .m-service-card__description {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    line-height: var(--lh-relaxed);
  }
  /* Nota de desarrollo, visible solo mientras el detalle operativo
     sigue pendiente de confirmación — no debería llegar a producción.
     Tokens --color-warning-* (tokens/colors.css), nunca hex suelto. */
  .m-service-card__pending {
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    font-size: var(--text-xs);
    font-style: italic;
    list-style: none;
  }
</style>
