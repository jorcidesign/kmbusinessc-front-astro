---
// src/components/molecules/Accordion/Accordion.astro
interface Props {
  title: string;
  open?: boolean;
  class?: string;
}

const { title, open = false, class: className = '' } = Astro.props;
---

<details class={`accordion ${className}`} open={open}>
  <summary class="accordion__summary">
    {title}
    <span class="accordion__icon" aria-hidden="true"></span>
  </summary>
  <div class="accordion__content">
    <slot />
  </div>
</details>
