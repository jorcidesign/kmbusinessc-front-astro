---
// src/components/atoms/illustrations/FlowChinaLatam.astro
import svgRaw from './flow-china-latam.svg?raw';

interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id } = Astro.props;
---

<div class={`illustration-wrapper illustration-wrapper--flow ${className}`} id={id} data-reveal data-reveal-class="is-active" set:html={svgRaw} />

<style>
  .illustration-wrapper {
    display: block;
    width: 100%;
  }

  .illustration-wrapper :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1232 / 520;
  }
</style>
