---
// src/components/atoms/Button/Button.astro
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'inverse' | 'whatsapp' | 'round';
  size?: 'sm' | 'md' | 'wide';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'solid',
  size = 'md',
  type = 'button',
  class: className = '',
  id,
  target,
  rel,
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const classes = [
  'btn',
  variant === 'outline' ? 'btn--outline' : '',
  variant === 'inverse' ? 'btn--inverse' : '',
  variant === 'whatsapp' ? 'btn--whatsapp' : '',
  variant === 'round' ? 'btn--round' : '',
  size === 'sm' ? 'btn--sm' : '',
  size === 'wide' ? 'btn--wide' : '',
  className,
].filter(Boolean).join(' ');
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class={classes}
  id={id}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
  {...rest}
>
  {variant === 'whatsapp' && (
    <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.49.08-1.11.11-1.79-.11-.41-.13-.94-.3-1.62-.6-2.85-1.23-4.71-4.1-4.85-4.29-.14-.19-1.16-1.54-1.16-2.94s.73-2.08.99-2.36c.26-.28.56-.35.75-.35h.54c.17 0 .4-.07.63.48.24.56.8 1.95.87 2.09.07.14.11.31.02.5-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.29.28-.12.55.17.28.75 1.24 1.61 2.01 1.11.99 2.04 1.3 2.32 1.44.28.14.44.12.6-.07.17-.19.71-.83.9-1.11.19-.28.38-.23.63-.14.26.09 1.65.78 1.93.92.28.14.47.21.54.33.07.12.07.68-.17 1.36Z"/>
    </svg>
  )}
  <slot />
</Tag>
