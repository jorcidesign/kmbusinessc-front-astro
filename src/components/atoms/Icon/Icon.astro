---
// src/components/atoms/Icon/Icon.astro
//
// Átomo de ícono centralizado — antes cada sitio (Badge, Footer,
// WhatsAppFab...) traía su propio <svg> duplicado. `currentColor` +
// tamaño por token (--icon-xs/sm/md/lg/xl de tokens/layout.css) y una
// micro-animación de hover (mismo criterio que ya usaba WhatsAppFab:
// scale() sobre --duration-fast/--ease-standard, apagada bajo
// prefers-reduced-motion) cuando el ícono vive dentro de un <a> o
// <button>.
type IconName = 'whatsapp' | 'linkedin' | 'instagram' | 'briefcase' | 'graduation-cap' | 'users' | 'check';

interface Props {
  name: IconName;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { name, size = 'sm', class: className = '' } = Astro.props;
---

<svg
  class={`a-icon a-icon--${size} ${className}`}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {name === 'whatsapp' && (
    <path
      fill="currentColor"
      d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.42 1.26 4.86L2 22l5.34-1.4a9.9 9.9 0 0 0 4.7 1.2h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm5.83 14.1c-.24.68-1.4 1.3-1.93 1.35-.5.06-1 .26-3.36-.7-2.84-1.16-4.66-4.05-4.8-4.24-.14-.19-1.15-1.53-1.15-2.92s.72-2.07.98-2.35c.24-.27.53-.34.7-.34.18 0 .35 0 .5.01.16.01.38-.06.6.46.24.57.8 1.96.87 2.1.07.15.12.32.02.51-.1.19-.15.3-.3.46-.15.16-.31.36-.44.48-.15.14-.3.29-.13.57.17.28.75 1.24 1.62 2 1.11 1 2.05 1.31 2.33 1.46.28.14.44.12.6-.07.17-.2.72-.84.91-1.13.19-.28.38-.23.63-.14.26.1 1.64.77 1.92.91.28.14.47.21.54.33.07.13.07.72-.17 1.4Z"
    />
  )}

  {name === 'linkedin' && (
    <path
      fill="currentColor"
      d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.33V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45Z"
    />
  )}

  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
      <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
    </>
  )}

  {name === 'briefcase' && (
    <>
      <rect x="2" y="7" width="20" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" fill="none" stroke="currentColor" stroke-width="2" />
    </>
  )}

  {name === 'graduation-cap' && (
    <>
      <path d="M22 10 12 5 2 10l10 5 10-5Z" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M6 12v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5" fill="none" stroke="currentColor" stroke-width="2" />
    </>
  )}

  {name === 'users' && (
    <>
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" fill="none" stroke="currentColor" stroke-width="2" />
      <circle cx="9" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M23 21v-2a4 4 0 0 0-3-3.87" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" fill="none" stroke="currentColor" stroke-width="2" />
    </>
  )}

  {name === 'check' && (
    <path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  )}
</svg>

<style>
  .a-icon {
    display: inline-block;
    flex: none;
    color: inherit;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .a-icon--xs { width: var(--icon-xs); height: var(--icon-xs); }
  .a-icon--sm { width: var(--icon-sm); height: var(--icon-sm); }
  .a-icon--md { width: var(--icon-md); height: var(--icon-md); }
  .a-icon--lg { width: var(--icon-lg); height: var(--icon-lg); }
  .a-icon--xl { width: var(--icon-xl); height: var(--icon-xl); }

  /* Si el ícono vive dentro de un <a>/<button>, reacciona al hover del
     padre sin que el consumidor tenga que declarar nada. */
  :global(a:hover .a-icon),
  :global(button:hover .a-icon) {
    transform: scale(1.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .a-icon {
      transition: none;
    }

    :global(a:hover .a-icon),
    :global(button:hover .a-icon) {
      transform: none;
    }
  }
</style>
