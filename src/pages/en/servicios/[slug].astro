---
import { getCollection, type CollectionEntry } from 'astro:content';
import ServicioDetalleTemplate from '../../_templates/ServicioDetalleTemplate.astro';

export const prerender = true;

// `slugMap`/`bareId` viven DENTRO de getStaticPaths a propósito: Astro
// extrae esta función de forma aislada del resto del frontmatter para
// generar las rutas, así que no puede cerrar sobre consts declaradas
// como hermanas a nivel de módulo (ver error "bareId is not defined").
export async function getStaticPaths() {
  const slugMap: Record<string, string> = {
    '01-logistica-integral': 'logistica-integral',
    '02-busqueda-proveedores': 'busqueda-proveedores',
    '03-inspeccion-fabricas': 'inspeccion-fabricas',
    '04-flete-maritimo': 'flete-maritimo',
  };
  const bareId = (id: string) => id.replace(/^\w+\//, '');

  const allServices = await getCollection('servicios', (entry) => entry.id.startsWith('en/'));

  return allServices.map((service) => {
    const bare = bareId(service.id);
    const slug = slugMap[bare] || bare.replace(/^\d+-/, '');
    return {
      params: { slug },
      props: { service, allServices },
    };
  });
}

interface Props {
  service: CollectionEntry<'servicios'>;
  allServices: CollectionEntry<'servicios'>[];
}

const { service, allServices } = Astro.props;
const { slug } = Astro.params;
---
<ServicioDetalleTemplate locale="en" slug={slug!} service={service} allServices={allServices} />
