---
import { getCollection, type CollectionEntry } from 'astro:content';
import ServicioDetalleTemplate from '../../_templates/ServicioDetalleTemplate.astro';

export const prerender = true;

// El slug viene directo del campo `slug` del schema (ver
// content.config.ts) — ya no hace falta un mapa hardcodeado por id de
// archivo, así que agregar un servicio nuevo es solo JSON, cero código.
export async function getStaticPaths() {
  const allServices = await getCollection('servicios', (entry) => entry.id.startsWith('es/'));

  return allServices.map((service) => ({
    params: { slug: service.data.slug },
    props: { service, allServices },
  }));
}

interface Props {
  service: CollectionEntry<'servicios'>;
  allServices: CollectionEntry<'servicios'>[];
}

const { service, allServices } = Astro.props;
const { slug } = Astro.params;
---
<ServicioDetalleTemplate locale="es" slug={slug!} service={service} allServices={allServices} />
