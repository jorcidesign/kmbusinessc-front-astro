---
// src/pages/_templates/HomeTemplate.astro
//
// Template compartido de la home ES/EN. Astro ignora todo lo que
// empieza con "_" dentro de src/pages/, así que este archivo no genera
// ninguna ruta propia — lo renderizan src/pages/es/index.astro y
// src/pages/en/index.astro pasándole `locale`. Cada literal en español
// sale de src/content/pages/home/<locale>.json.
//
// Rearmado para el mapa maestro SEO (9 URLs): el orden de bloques que
// pide el documento es Hero → Servicios (5, con link a su landing) →
// Por qué KM → Cómo trabajamos → Kattya → FAQs → Contacto. El bloque
// de "China → Latinoamérica" del documento ya vive dentro del propio
// Hero (ver FlowChinaLatam en HeroKattya.astro) y el bloque de
// stats/cifras se eliminó — el documento prohíbe publicar números sin
// confirmar, y su contenido queda cubierto por "Por qué KM" + "Cómo
// trabajamos".
import { getEntry, getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroKattya from '@organisms/HeroKattya/HeroKattya.astro';
import RuledGridSection from '@organisms/RuledGridSection/RuledGridSection.astro';
import FAQSection from '@organisms/FAQSection/FAQSection.astro';
import Marquee from '@organisms/Marquee/Marquee.astro';
import ContactForm from '@molecules/ContactForm/ContactForm.astro';
import WhatsAppButton from '@atoms/WhatsAppButton/WhatsAppButton.astro';
import Button from '@atoms/Button/Button.astro';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const withLocale = (path: string) => getRelativeLocaleUrl(locale, path);

const pageEntry = await getEntry('pageHome', locale);
if (!pageEntry) throw new Error(`Falta src/content/pages/home/${locale}.json`);
const page = pageEntry.data;

const uiEntry = await getEntry('ui', locale);
if (!uiEntry) throw new Error(`Falta src/content/ui/${locale}.json`);
const ui = uiEntry.data;

const servicios = (await getCollection('servicios', (entry) => entry.id.startsWith(`${locale}/`)))
  .sort((a, b) => a.data.orden - b.data.orden);

const proceso = (await getCollection('proceso', (entry) => entry.id.startsWith(`${locale}/`)))
  .sort((a, b) => a.data.orden - b.data.orden);

const faqEntries = (await getCollection('faqs', (entry) => entry.id.startsWith(`${locale}/`)))
  .sort((a, b) => a.data.orden - b.data.orden);
const faqCategories = faqEntries.map((entry) => ({
  title: entry.data.categoria,
  items: entry.data.preguntas.map((p) => ({ question: p.pregunta, answer: p.respuesta })),
}));

const contactForm = ui.contactForm;
---

<BaseLayout title={page.seo.title} description={page.seo.description} locale={locale}>
  <!-- 1. HERO CON FOTO DE KATTYA, DOS TITULARES Y EL FLUJO CHINA → LATAM -->
  <HeroKattya
    heading={page.hero.heading}
    titleFade={page.hero.titleFade}
    titleRiseLines={page.hero.titleRiseLines}
    lead={page.hero.lead}
    cta={{ label: page.hero.ctaLabel, href: withLocale('/contacto') }}
    image={{
      src: '/images/kattya-hero.jpg',
      alt: page.hero.imageAlt,
      width: 500,
      height: 700,
    }}
  />

  <!-- 2. NUESTROS 5 SERVICIOS, CADA UNO CON LINK A SU LANDING -->
  <section class="section section--ruled section--framed" id="servicios">
    <div class="container gutter">
      <div class="section-header section-header--spaced">
        <h2 class="section-header__title">{page.servicesIntro.title}</h2>
        <p class="section-header__lead">
          {page.servicesIntro.lead}
        </p>
      </div>

      <div class="ruled-grid ruled-grid--2 ruled-grid--surface ruled-grid--odd-span mt-3xl">
        {servicios.map((srv) => (
          <article class="service-card-item">
            <div class="service-card-item__top">
              <span class="tag tag--navy">{srv.data.badge || `0${srv.data.orden}`}</span>
              <span class="service-card-item__num">0{srv.data.orden}</span>
            </div>
            <h3 class="service-card-item__title">{srv.data.titulo}</h3>
            <p class="service-card-item__desc">{srv.data.descripcion}</p>
            <div class="service-card-item__footer">
              <Button href={withLocale(`/servicios/${srv.data.slug}`)} variant="outline" size="sm">
                {srv.data.ctaPrincipal.label} &rarr;
              </Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. POR QUÉ TRABAJAR CON KM (CONFIANZA, INTEGRIDAD, ATENCIÓN, VISIÓN) -->
  <RuledGridSection heading={page.ruledGrid.title} lead={page.ruledGrid.lead} items={page.ruledGrid.items} />

  <!-- 4. CÓMO TRABAJAMOS (4 PASOS) -->
  {proceso.length > 0 && (
    <section class="section section--subtle section--ruled section--framed" id="proceso">
      <div class="container gutter">
        <div class="section-header">
          <h2 class="section-header__title">{page.comoTrabajamos.title}</h2>
        </div>
        <ol class="steps steps--horizontal mt-2xl" role="list">
          {proceso.map((paso) => (
            <li class="steps__item">
              <span class="steps__marker"></span>
              <div class="steps__body">
                <strong class="steps__label">{paso.data.paso}</strong>
                <p class="steps__desc">{paso.data.descripcion}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- 5. KATTYA: CONFIANZA DETRÁS DE KM -->
  <section class="section section--subtle section--framed section--clip" id="manifiesto">
    <div class="decor-field" aria-hidden="true">
      <div class="decor-field__line-wrap" style="--x:2%; --y:8%" data-parallax-speed="0.05">
        <span class="decor-field__line decor-field__line--1" style="--angle:-28deg; --length:32rem"></span>
      </div>
      <div class="decor-field__line-wrap" style="--x:26%; --y:58%" data-parallax-speed="0.1">
        <span class="decor-field__line decor-field__line--2" style="--angle:28deg; --length:26rem"></span>
      </div>
      <div class="decor-field__line-wrap" style="--x:50%; --y:6%" data-parallax-speed="0.07">
        <span class="decor-field__line decor-field__line--3" style="--angle:-28deg; --length:30rem"></span>
      </div>
      <div class="decor-field__line-wrap" style="--x:72%; --y:62%" data-parallax-speed="0.12">
        <span class="decor-field__line decor-field__line--1" style="--angle:28deg; --length:24rem"></span>
      </div>
      <div class="decor-field__line-wrap" style="--x:90%; --y:4%" data-parallax-speed="0.08">
        <span class="decor-field__line decor-field__line--2" style="--angle:-28deg; --length:18rem"></span>
      </div>
    </div>
    <div class="container gutter">
      <div class="cta-box">
        <div class="cta-box__inner">
          <div class="cta-box__body">
            <span class="tag tag--navy mb-sm">{page.manifiesto.tag}</span>
            <h2 class="cta-box__title">{page.manifiesto.title}</h2>
            <p class="cta-box__text">
              {page.manifiesto.quote}
            </p>
            {/*
              ⚠️ CONTRADICCIÓN SIN RESOLVER (mismo caso que
              NosotrosTemplate.astro → page.profileCard): `authorRole`
              publica "Magíster en Negocios Internacionales (10+ años
              de experiencia)", confirmado por Kattya en la llamada
              grabada del 23 de septiembre, pero el documento SEO
              maestro aprobado después pide no publicar esa credencial
              sin su confirmación directa. No se tocó por instrucción
              expresa del encargo — lo resuelve Jorge con Renzo y
              Kattya.
            */}
            <div class="cta-box__author mt-md">
              <strong>{page.manifiesto.authorName}</strong> &middot; <span style="color:var(--color-text-muted)">{page.manifiesto.authorRole}</span>
            </div>
          </div>
          <div class="cta-box__action">
            <a class="btn" href={withLocale('/nosotros')}>{page.manifiesto.ctaLabel}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. PREGUNTAS FRECUENTES -->
  <FAQSection title={page.faq.title} lead={page.faq.lead} categories={faqCategories} />

  <!-- 7. CONTACTO RÁPIDO CON LAYOUT SPLIT -->
  <section class="section--subtle section--ruled" id="contacto-home">
    <div class="container">
      <div class="contact">
        <div class="contact__heading">
          <span class="tag tag--navy mb-sm">{page.contactHome.tag}</span>
          <h2 class="contact__title">{page.contactHome.title}</h2>
          <p class="contact__lead">
            {page.contactHome.lead}
          </p>
          <div class="mt-lg">
            <WhatsAppButton location="home_contact" message={ui.whatsapp.defaultMessage}>{page.contactHome.whatsappLabel}</WhatsAppButton>
          </div>
        </div>
        <div class="contact__divider" aria-hidden="true"></div>
        <ContactForm
          servicios={servicios.map((s) => ({ slug: s.data.slug, titulo: s.data.titulo }))}
          labelNombre={contactForm.labels.nombre}
          labelWhatsapp={contactForm.labels.whatsapp}
          labelEmpresa={contactForm.labels.empresa}
          labelCorreo={contactForm.labels.correo}
          labelProducto={contactForm.labels.producto}
          labelServicio={contactForm.labels.servicio}
          labelCantidad={contactForm.labels.cantidad}
          labelMensaje={contactForm.labels.mensaje}
          labelHoneypot={contactForm.labels.honeypot}
          placeholderNombre={contactForm.placeholders.nombre}
          placeholderWhatsapp={contactForm.placeholders.whatsapp}
          placeholderEmpresa={contactForm.placeholders.empresa}
          placeholderCorreo={contactForm.placeholders.correo}
          placeholderProducto={contactForm.placeholders.producto}
          placeholderCantidad={contactForm.placeholders.cantidad}
          placeholderMensaje={contactForm.placeholders.mensaje}
          servicioOptionsLabel={contactForm.servicioOptionsLabel}
          submitLabel={contactForm.submitLabel}
          sendingLabel={contactForm.sendingLabel}
          validationError={contactForm.validationError}
          successMessage={contactForm.successMessage}
          errorMessage={contactForm.errorMessage}
        />
      </div>
    </div>
  </section>

  <!-- 8. MARQUEE CONTINUO -->
  <Marquee text={page.marqueeText} />
</BaseLayout>

<style>
  .cta-box__author {
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .service-card-item {
    display: flex;
    flex-direction: column;
    padding: var(--cell-pad-lg);
    background-color: var(--color-surface);
  }
  .service-card-item__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }
  .service-card-item__num {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-subtle);
  }
  .service-card-item__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-sm);
  }
  .service-card-item__desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
  }
  .service-card-item__footer {
    margin-top: auto;
    padding-top: var(--space-md);
  }
  /* 5 servicios en un grid de 2 columnas: la última tarjeta queda sola
     en la fila final — se extiende a lo ancho en vez de dejar un hueco. */
  @media (min-width: 48em) {
    .ruled-grid--odd-span > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .steps--horizontal {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48em) {
    .steps--horizontal { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 64em) {
    .steps--horizontal { grid-template-columns: repeat(4, 1fr); }
  }
  .steps__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .steps__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>
