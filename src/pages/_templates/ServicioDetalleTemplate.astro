---
// src/pages/_templates/ServicioDetalleTemplate.astro
// Ver HomeTemplate.astro para la explicación del patrón _templates/.
// getStaticPaths vive en src/pages/es/servicios/[slug].astro y
// src/pages/en/servicios/[slug].astro (cada uno filtra `servicios` por
// su propio locale) — este template solo recibe `service`/`allServices`
// ya resueltos y arma el markup.
import { getEntry, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@organisms/Hero/Hero.astro';
import RuledFeature from '@molecules/RuledFeature/RuledFeature.astro';
import type { FeatureIconName, FeatureIconAccent } from '@atoms/FeatureIcon/FeatureIcon.astro';
import ContactForm from '@molecules/ContactForm/ContactForm.astro';
import WhatsAppButton from '@atoms/WhatsAppButton/WhatsAppButton.astro';

interface Props {
  locale: 'es' | 'en';
  slug: string;
  service: CollectionEntry<'servicios'>;
  allServices: CollectionEntry<'servicios'>[];
}

const { locale, slug, service, allServices } = Astro.props;
const withLocale = (path: string) => getRelativeLocaleUrl(locale, path);

const uiEntry = await getEntry('ui', locale);
if (!uiEntry) throw new Error(`Falta src/content/ui/${locale}.json`);
const ui = uiEntry.data;
const sd = ui.serviceDetail;
const contactForm = ui.contactForm;

const isLogistica = slug === 'logistica-integral';
const isBusqueda = slug === 'busqueda-proveedores';
const isInspeccion = slug === 'inspeccion-fabricas';
const isFlete = slug === 'flete-maritimo';

const slugMap: Record<string, string> = {
  '01-logistica-integral': 'logistica-integral',
  '02-busqueda-proveedores': 'busqueda-proveedores',
  '03-inspeccion-fabricas': 'inspeccion-fabricas',
  '04-flete-maritimo': 'flete-maritimo',
};
const bareId = (id: string) => id.replace(/^\w+\//, '');

const sortedServices = [...allServices].sort((a, b) => a.data.orden - b.data.orden);
const currentIndex = sortedServices.findIndex((s) => s.id === service.id);
const prevService = currentIndex > 0 ? sortedServices[currentIndex - 1] : null;
const nextService = currentIndex < sortedServices.length - 1 ? sortedServices[currentIndex + 1] : null;

const prevSlug = prevService ? (slugMap[bareId(prevService.id)] || bareId(prevService.id).replace(/^\d+-/, '')) : null;
const nextSlug = nextService ? (slugMap[bareId(nextService.id)] || bareId(nextService.id).replace(/^\d+-/, '')) : null;

const benefitAccents: FeatureIconAccent[] = ['blue', 'mint', 'amber', 'coral'];
const benefitIcons: FeatureIconName[] = ['verified-check', 'handshake', 'open-ledger', 'shield'];
---

<BaseLayout
  title={`${service.data.titulo} | ${locale === 'es' ? 'Servicios' : 'Services'}`}
  description={service.data.descripcion}
  locale={locale}
>
  <!-- HERO SPLIT DEL SERVICIO CON LA ANIMACIÓN VECTORIAL CORRESPONDIENTE -->
  <Hero
    variant="split"
    eyebrow={service.data.badge || `${sd.eyebrowFallbackPrefix}${service.data.orden}`}
    title={service.data.titulo}
    lead={service.data.subtitulo || service.data.descripcion}
    primaryAction={{ label: sd.primaryActionLabel, href: '#cotizar' }}
    secondaryAction={{ label: sd.secondaryActionLabel, href: withLocale('/servicios') }}
  >
    <div slot="media" class="service-detail-hero__media service-detail-hero__media--image">
      {isLogistica && (
        <img
          src="/images/logistica-integral-hero.jpg"
          alt="Logística integral de importación desde China a Latinoamérica"
          class="service-detail-hero__image"
          width="678"
          height="381"
          loading="eager"
          decoding="async"
        />
      )}
      {isBusqueda && (
        <img
          src="/images/busqueda-proveedores-hero.jpg"
          alt="Búsqueda y verificación de proveedores confiables en China"
          class="service-detail-hero__image"
          width="730"
          height="427"
          loading="eager"
          decoding="async"
        />
      )}
      {isInspeccion && (
        <img
          src="/images/inspeccion-fabricas-hero.jpg"
          alt="Control de calidad e inspección de fábricas en China"
          class="service-detail-hero__image"
          width="626"
          height="417"
          loading="eager"
          decoding="async"
        />
      )}
      {isFlete && (
        <img
          src="/images/flete-maritimo-hero.jpg"
          alt="Fletes marítimos internacionales y logística FCL"
          class="service-detail-hero__image"
          width="765"
          height="550"
          loading="eager"
          decoding="async"
        />
      )}
    </div>
  </Hero>

  <!-- QUÉ HACEMOS Y ESPECIFICACIONES TÉCNICAS -->
  <section class="section section--ruled section--framed" id="detalles">
    <div class="container gutter">
      <div class="grid items-start">
        <div class="col-5">
          <span class="tag tag--navy mb-sm">{sd.scopeTag}</span>
          <h2 class="heading-lg">{sd.scopeTitle}</h2>
          <p class="mt-md text-color-muted">
            {service.data.descripcion}
          </p>

          {service.data.specs && (
            <div class="mt-2xl">
              <h3 class="heading-sm mb-md text-color-main">{sd.specsTitle}</h3>
              <dl class="specs-list">
                {Object.entries(service.data.specs).map(([key, val]) => (
                  <div class="spec-row">
                    <dt class="spec-key">{key}</dt>
                    <dd class="spec-val">{val}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>

        <div class="col-7">
          {service.data.queHacemos && (
            <div class="scope-box">
              <h3 class="heading-sm mb-lg">{sd.deliverablesTitle}</h3>
              <ul class="scope-list" role="list">
                {service.data.queHacemos.map((item, idx) => (
                  <li class="scope-item">
                    <span class="scope-badge">0{idx + 1}</span>
                    <span class="scope-text">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFICIOS CLAVE DEL SERVICIO (RULED GRID) -->
  {service.data.beneficios && service.data.beneficios.length > 0 && (
    <section class="section section--subtle section--ruled section--framed section--sm">
      <div class="container gutter">
        <div class="section-header">
          <h2 class="section-header__title">{sd.benefitsTitle}</h2>
          <p class="section-header__lead">
            {sd.benefitsLead}
          </p>
        </div>
      </div>
    </section>

    <section class="section--flush section--framed">
      <div class={`ruled-grid ruled-grid--${service.data.beneficios.length >= 4 ? '4' : '2'} ruled-grid--no-left`}>
        {service.data.beneficios.map((ben, bIdx) => (
          <RuledFeature
            title={ben.titulo}
            description={ben.descripcion}
            icon={benefitIcons[bIdx % benefitIcons.length]}
            accent={benefitAccents[bIdx % benefitAccents.length]}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ETAPAS DE EJECUCIÓN -->
  {service.data.etapas && service.data.etapas.length > 0 && (
    <section class="section section--ruled section--framed">
      <div class="container gutter">
        <div class="grid items-start">
          <div class="col-5">
            <span class="tag tag--navy mb-sm">{sd.stagesTag}</span>
            <h2 class="heading-lg">{sd.stagesTitle}</h2>
            <p class="mt-md text-color-muted">
              {sd.stagesLead}
            </p>
          </div>
          <div class="col-7">
            <ol class="steps" role="list">
              {service.data.etapas.map((etapa) => (
                <li class="steps__item">
                  <span class="steps__marker"></span>
                  <div class="steps__body">
                    <strong class="steps__label">{etapa.paso}</strong>
                    <p class="steps__desc">{etapa.detalle}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FORMULARIO DE COTIZACIÓN DIRECTA PARA ESTE SERVICIO -->
  <section class="section--subtle section--ruled" id="cotizar">
    <div class="container">
      <div class="contact">
        <div class="contact__heading">
          <span class="tag tag--navy mb-sm">{sd.quoteTag}</span>
          <h2 class="contact__title">{sd.quoteTitlePrefix}{service.data.titulo}</h2>
          <p class="contact__lead">
            {sd.quoteLead}
          </p>
          <div class="mt-xl">
            <WhatsAppButton
              location={`service_${slug}`}
              message={`${sd.whatsappMessagePrefix}${service.data.titulo}.`}
            >
              {sd.whatsappLabel}
            </WhatsAppButton>
          </div>
        </div>
        <div class="contact__divider" aria-hidden="true"></div>
        <ContactForm
          defaultService={service.data.titulo}
          labelNombre={contactForm.labels.nombre}
          labelWhatsapp={contactForm.labels.whatsapp}
          labelProducto={contactForm.labels.producto}
          labelCantidad={contactForm.labels.cantidad}
          labelMensaje={contactForm.labels.mensaje}
          labelHoneypot={contactForm.labels.honeypot}
          placeholderNombre={contactForm.placeholders.nombre}
          placeholderWhatsapp={contactForm.placeholders.whatsapp}
          placeholderProducto={contactForm.placeholders.producto}
          placeholderCantidad={contactForm.placeholders.cantidad}
          placeholderMensaje={contactForm.placeholders.mensaje}
          submitLabel={contactForm.submitLabel}
          sendingLabel={contactForm.sendingLabel}
          validationError={contactForm.validationError}
          successMessage={contactForm.successMessage}
          errorMessage={contactForm.errorMessage}
        />
      </div>
    </div>
  </section>

  <!-- NAVEGACIÓN ANTERIOR / SIGUIENTE SERVICIO -->
  <nav class="service-nav-bar section--framed" aria-label={sd.navAriaLabel}>
    <div class="container gutter">
      <div class="service-nav-bar__inner">
        {prevService && prevSlug ? (
          <a class="service-nav-link service-nav-link--prev" href={withLocale(`/servicios/${prevSlug}`)}>
            <span class="service-nav-dir">&larr; {sd.prevLabel}</span>
            <strong class="service-nav-name">{prevService.data.titulo}</strong>
          </a>
        ) : <div />}

        {nextService && nextSlug ? (
          <a class="service-nav-link service-nav-link--next" href={withLocale(`/servicios/${nextSlug}`)}>
            <span class="service-nav-dir">{sd.nextLabel} &rarr;</span>
            <strong class="service-nav-name">{nextService.data.titulo}</strong>
          </a>
        ) : <div />}
      </div>
    </div>
  </nav>
</BaseLayout>

<style>
  .service-detail-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 24rem;
    padding: var(--space-xl);
  }
  .service-detail-hero__media--image {
    padding: 0;
    overflow: hidden;
  }
  .service-detail-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .specs-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-top: var(--rule-hairline);
    padding-top: var(--space-md);
  }
  .spec-row {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-xs);
    border-bottom: var(--rule-hairline);
  }
  .spec-key {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .spec-val {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin-top: 2px;
  }
  .scope-box {
    background-color: var(--color-surface);
    border: var(--rule-hairline);
    padding: var(--space-2xl);
  }
  .scope-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .scope-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: var(--rule-hairline);
  }
  .scope-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .scope-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-subtle);
    color: var(--color-brand);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    flex-shrink: 0;
  }
  .scope-text {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.5;
  }
  .steps__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .steps__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .service-nav-bar {
    border-top: var(--rule-hairline);
    background-color: var(--color-surface);
    padding-block: var(--space-xl);
  }
  .service-nav-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }
  .service-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    text-decoration: none;
    color: var(--color-text);
    transition: opacity 0.15s ease;
  }
  .service-nav-link:hover {
    opacity: 0.75;
  }
  .service-nav-link--next {
    text-align: right;
    align-items: flex-end;
  }
  .service-nav-dir {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .service-nav-name {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }
</style>
