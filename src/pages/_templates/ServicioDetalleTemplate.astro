---
// src/pages/_templates/ServicioDetalleTemplate.astro
// Ver HomeTemplate.astro para la explicación del patrón _templates/.
// getStaticPaths vive en src/pages/es/servicios/[slug].astro y
// src/pages/en/servicios/[slug].astro (cada uno filtra `servicios` por
// su propio locale) — este template solo recibe `service`/`allServices`
// ya resueltos y arma el markup.
import { getEntry, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@organisms/Hero/Hero.astro';
import FAQSection from '@organisms/FAQSection/FAQSection.astro';
import RuledFeature from '@molecules/RuledFeature/RuledFeature.astro';
import type { FeatureIconName, FeatureIconAccent } from '@atoms/FeatureIcon/FeatureIcon.astro';
import ContactForm from '@molecules/ContactForm/ContactForm.astro';
import WhatsAppButton from '@atoms/WhatsAppButton/WhatsAppButton.astro';

interface Props {
  locale: 'es' | 'en';
  slug: string;
  service: CollectionEntry<'servicios'>;
  allServices: CollectionEntry<'servicios'>[];
}

const { locale, slug, service, allServices } = Astro.props;
const withLocale = (path: string) => getRelativeLocaleUrl(locale, path);

const uiEntry = await getEntry('ui', locale);
if (!uiEntry) throw new Error(`Falta src/content/ui/${locale}.json`);
const ui = uiEntry.data;
const sd = ui.serviceDetail;
const contactForm = ui.contactForm;

const sortedServices = [...allServices].sort((a, b) => a.data.orden - b.data.orden);
const currentIndex = sortedServices.findIndex((s) => s.id === service.id);
const prevService = currentIndex > 0 ? sortedServices[currentIndex - 1] : null;
const nextService = currentIndex < sortedServices.length - 1 ? sortedServices[currentIndex + 1] : null;

const relatedServices = service.data.serviciosRelacionados
  .map((relSlug) => allServices.find((s) => s.data.slug === relSlug))
  .filter((s): s is CollectionEntry<'servicios'> => Boolean(s));

const benefitAccents: FeatureIconAccent[] = ['blue', 'mint', 'amber', 'coral'];
const benefitIcons: FeatureIconName[] = ['verified-check', 'handshake', 'open-ledger', 'shield'];
---

<BaseLayout title={service.data.seoTitle} description={service.data.metaDescription} locale={locale}>
  <!-- HERO SPLIT DEL SERVICIO -->
  <Hero
    variant="split"
    eyebrow={service.data.badge || `${sd.eyebrowFallbackPrefix}${service.data.orden}`}
    title={service.data.h1}
    lead={service.data.heroIntro}
    primaryAction={{ label: service.data.ctaPrincipal.label, href: '#cotizar' }}
    secondaryAction={{ label: service.data.ctaSecundario?.label || sd.secondaryActionLabel, href: withLocale('/servicios') }}
  >
    <div slot="media" class="service-detail-hero__media service-detail-hero__media--image">
      <img
        src={service.data.heroImage?.src ?? '/images/servicio-generic-hero.jpg'}
        alt={service.data.heroImage?.alt ?? service.data.titulo}
        class="service-detail-hero__image"
        width={service.data.heroImage?.width ?? 700}
        height={service.data.heroImage?.height ?? 420}
        loading="eager"
        decoding="async"
      />
    </div>
  </Hero>

  <!-- AVISO DE CONTENIDO PENDIENTE DE VALIDACIÓN — máxima visibilidad,
       justo después del hero. Ver jerarquía de fuente del documento
       SEO maestro: CONFIRMADO CLIENTE / PENDIENTE / PLACEHOLDER DEMO. -->
  {service.data.pendiente && service.data.pendiente.length > 0 && (
    <section class="section--flush section--framed">
      <div class="container gutter">
        <div class="service-pending-notice" role="note">
          <strong class="service-pending-notice__label">⚠ {sd.pendienteLabel}</strong>
          <ul class="service-pending-notice__list" role="list">
            {service.data.pendiente.map((nota) => <li>{nota}</li>)}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- ESPECIFICACIONES (solo si el servicio las trae) -->
  {service.data.specs && (
    <section class="section section--ruled section--framed section--sm">
      <div class="container gutter">
        <h2 class="heading-sm mb-md text-color-main">{sd.specsTitle}</h2>
        <dl class="specs-list">
          {Object.entries(service.data.specs).map(([key, val]) => (
            <div class="spec-row">
              <dt class="spec-key">{key}</dt>
              <dd class="spec-val">{val}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- SECCIONES DE CONTENIDO (H2 + prosa o sub-puntos, ver content.config.ts) -->
  {service.data.secciones.map((sec) => (
    <section class="section section--ruled section--framed">
      <div class="container gutter">
        <h2 class="heading-lg">{sec.h2}</h2>
        {sec.cuerpo && (
          <div class="mt-md text-color-muted">
            {sec.cuerpo.split('\n\n').map((parrafo) => <p class="mb-md">{parrafo}</p>)}
          </div>
        )}
        {sec.items && sec.items.length > 0 && (
          <div class={`ruled-grid ruled-grid--${sec.items.length >= 4 ? '4' : '2'} ruled-grid--no-left mt-xl`}>
            {sec.items.map((it, idx) => (
              <RuledFeature
                title={it.titulo}
                description={it.texto}
                icon={benefitIcons[idx % benefitIcons.length]}
                accent={benefitAccents[idx % benefitAccents.length]}
              />
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- PREGUNTAS FRECUENTES DEL SERVICIO -->
  {service.data.faqs.length > 0 && (
    <FAQSection
      title={sd.faqsTitle}
      categories={[{ title: service.data.titulo, items: service.data.faqs.map((f) => ({ question: f.pregunta, answer: f.respuesta })) }]}
    />
  )}

  <!-- ENLAZADO INTERNO SUGERIDO -->
  {relatedServices.length > 0 && (
    <section class="section section--subtle section--ruled section--framed section--sm">
      <div class="container gutter">
        <h2 class="heading-sm mb-md text-color-main">{sd.relatedTitle}</h2>
        <div class="related-services" role="list">
          {relatedServices.map((rel) => (
            <a class="btn btn--outline btn--sm" href={withLocale(`/servicios/${rel.data.slug}`)} role="listitem">
              {rel.data.titulo}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FORMULARIO DE COTIZACIÓN DIRECTA PARA ESTE SERVICIO -->
  <section class="section--subtle section--ruled" id="cotizar">
    <div class="container">
      <div class="contact">
        <div class="contact__heading">
          <span class="tag tag--navy mb-sm">{sd.quoteTag}</span>
          <h2 class="contact__title">{sd.quoteTitlePrefix}{service.data.titulo}</h2>
          <p class="contact__lead">
            {sd.quoteLead}
          </p>
          <div class="mt-xl">
            <WhatsAppButton
              location={`service_${slug}`}
              message={`${sd.whatsappMessagePrefix}${service.data.titulo}.`}
            >
              {sd.whatsappLabel}
            </WhatsAppButton>
          </div>
        </div>
        <div class="contact__divider" aria-hidden="true"></div>
        <ContactForm
          defaultService={service.data.titulo}
          servicios={allServices.map((s) => ({ slug: s.data.slug, titulo: s.data.titulo }))}
          labelNombre={contactForm.labels.nombre}
          labelWhatsapp={contactForm.labels.whatsapp}
          labelEmpresa={contactForm.labels.empresa}
          labelCorreo={contactForm.labels.correo}
          labelProducto={contactForm.labels.producto}
          labelServicio={contactForm.labels.servicio}
          labelCantidad={contactForm.labels.cantidad}
          labelMensaje={contactForm.labels.mensaje}
          labelHoneypot={contactForm.labels.honeypot}
          placeholderNombre={contactForm.placeholders.nombre}
          placeholderWhatsapp={contactForm.placeholders.whatsapp}
          placeholderEmpresa={contactForm.placeholders.empresa}
          placeholderCorreo={contactForm.placeholders.correo}
          placeholderProducto={contactForm.placeholders.producto}
          placeholderCantidad={contactForm.placeholders.cantidad}
          placeholderMensaje={contactForm.placeholders.mensaje}
          servicioOptionsLabel={contactForm.servicioOptionsLabel}
          submitLabel={contactForm.submitLabel}
          sendingLabel={contactForm.sendingLabel}
          validationError={contactForm.validationError}
          successMessage={contactForm.successMessage}
          errorMessage={contactForm.errorMessage}
        />
      </div>
    </div>
  </section>

  <!-- NAVEGACIÓN ANTERIOR / SIGUIENTE SERVICIO -->
  <nav class="service-nav-bar section--framed" aria-label={sd.navAriaLabel}>
    <div class="container gutter">
      <div class="service-nav-bar__inner">
        {prevService ? (
          <a class="service-nav-link service-nav-link--prev" href={withLocale(`/servicios/${prevService.data.slug}`)}>
            <span class="service-nav-dir">&larr; {sd.prevLabel}</span>
            <strong class="service-nav-name">{prevService.data.titulo}</strong>
          </a>
        ) : <div />}

        {nextService ? (
          <a class="service-nav-link service-nav-link--next" href={withLocale(`/servicios/${nextService.data.slug}`)}>
            <span class="service-nav-dir">{sd.nextLabel} &rarr;</span>
            <strong class="service-nav-name">{nextService.data.titulo}</strong>
          </a>
        ) : <div />}
      </div>
    </div>
  </nav>
</BaseLayout>

<style>
  .service-detail-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 24rem;
    padding: var(--space-xl);
  }
  .service-detail-hero__media--image {
    padding: 0;
    overflow: hidden;
  }
  .service-detail-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .specs-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-top: var(--rule-hairline);
    padding-top: var(--space-md);
  }
  .spec-row {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-xs);
    border-bottom: var(--rule-hairline);
  }
  .spec-key {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .spec-val {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin-top: 2px;
  }
  /* Patrón "pendiente": siempre con los tokens --color-warning-*, nunca
     hex hardcodeado (ver el defecto que tenía ServiceCard.astro). */
  .service-pending-notice {
    background-color: var(--color-warning-bg);
    color: var(--color-warning-text);
    border: 1px solid var(--color-warning);
    border-radius: var(--radius-sm);
    padding: var(--space-md) var(--space-lg);
  }
  .service-pending-notice__label {
    display: block;
    margin-bottom: var(--space-xs);
    font-size: var(--text-sm);
  }
  .service-pending-notice__list {
    margin: 0;
    padding-left: var(--space-lg);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .related-services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .service-nav-bar {
    border-top: var(--rule-hairline);
    background-color: var(--color-surface);
    padding-block: var(--space-xl);
  }
  .service-nav-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }
  .service-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    text-decoration: none;
    color: var(--color-text);
    transition: opacity 0.15s ease;
  }
  .service-nav-link:hover {
    opacity: 0.75;
  }
  .service-nav-link--next {
    text-align: right;
    align-items: flex-end;
  }
  .service-nav-dir {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .service-nav-name {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }
</style>
