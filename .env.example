# URL de la Web App de Google Apps Script (termina en /exec).
# La genera Jorge al implementar el script en la cuenta de Google de Kattya.
CONTACT_SCRIPT_URL=

# Token secreto compartido con el script (PropertiesService en Apps Script).
# Cualquier string largo y aleatorio sirve. No es un secreto de altísima
# seguridad (el formulario es público), pero evita que alguien spamee
# el endpoint directamente sin pasar por el formulario.
CONTACT_SCRIPT_TOKEN=

# ID de Google Tag Manager. Placeholder hasta que Renzo cree el contenedor.
PUBLIC_GTM_ID=GTM-XXXXXXX

# Número de WhatsApp de Kattya en formato internacional sin '+' ni espacios.
# CONFIRMAR: ¿es el mismo +51 945 832 446 del sitio actual, o uno nuevo
# dedicado a cotizaciones?
PUBLIC_WHATSAPP_NUMBER=51945832446
